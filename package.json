{
  "name": "section1983.org",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "diagrams": "printf 'Generating Mermaid chart: process-flowchart.svg\\n' && mmdc -p diagrams/puppeteer.json -i diagrams/process-flowchart.mmd -o public/diagrams/process-flowchart.svg -t neutral -b transparent",
    "build": "npm run diagrams && GIT_COMMIT_SHA=${GIT_COMMIT_SHA:-$(git rev-parse --short=12 HEAD)} GIT_COMMIT_DIRTY=${GIT_COMMIT_DIRTY:-$(if git diff --quiet HEAD -- && [ -z \"$(git ls-files --others --exclude-standard)\" ]; then echo 0; else echo 1; fi)} astro build",
    "preview": "astro preview",
    "astro": "astro",
    "readability": "node scripts/readability-audit.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check && tsc --noEmit",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test:infra && npm run test:analytics-config && npm run test:consent",
    "analytics:pull": "bash scripts/analytics.sh pull",
    "analytics:push": "bash scripts/analytics.sh push",
    "analytics:compare": "bash scripts/analytics.sh compare",
    "infra:account": "bash scripts/infra.sh account",
    "infra:init": "bash scripts/infra.sh init",
    "infra:plan": "bash scripts/infra.sh plan",
    "infra:apply": "bash scripts/infra.sh apply",
    "infra:output": "bash scripts/infra.sh output",
    "infra:format": "bash scripts/infra.sh format",
    "infra:format:check": "bash scripts/infra.sh format:check",
    "infra:validate": "bash scripts/infra.sh validate",
    "infra:create-user": "bash scripts/infra.sh create-user",
    "test:analytics-config": "node --test scripts/analytics-config.test.mjs scripts/analytics-plan.test.mjs",
    "test:consent": "node --test scripts/consent-preferences.test.mjs scripts/google-consent.test.mjs",
    "test:infra": "node --test scripts/terraform-account.test.mjs scripts/require-approved-terraform-destroys.test.mjs scripts/parameter-store-secrets.test.mjs scripts/terraform-tracked-inputs.test.mjs scripts/terraform-reviewed-apply.test.mjs",
    "test:a11y": "npm run build && playwright test",
    "test:a11y:full": "npm run build && A11Y_FULL=1 playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/rss": "^4.0.17",
    "@astrojs/sitemap": "^3.7.1",
    "@sentry/astro": "^11.12.0",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^7.4.12",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@mermaid-js/mermaid-cli": "^12.2.0",
    "@playwright/test": "^1.65.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.1.0",
    "eslint-plugin-astro": "^3.2.1",
    "playwright-core": "^1.65.1",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "26.13.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "puppeteer@25.17.0": true
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    },
    "@zenuml/core": {
      "playwright-core": "$playwright-core"
    }
  }
}
