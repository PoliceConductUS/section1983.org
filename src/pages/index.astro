---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import { buildHubIndex } from "../lib/case-hub-index";
import { STATE_LIMITATIONS } from "../lib/sol-data";

const allArticles = await getCollection("articles");
const articles = allArticles
  .filter(({ data }) => !data.draft)
  .sort((a, b) => {
    const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
    const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
    return dateA - dateB;
  });

const cases = await getCollection("cases");
const termsAndConcepts = await getCollection("termsAndConcepts");
const process = await getCollection("process");
const staticPages = [
  "/",
  "/downloads/",
  "/statute-of-limitations/",
  "/about/",
  "/about/section-1983/",
  "/accessibility/",
  "/articles/",
  "/cases/",
  "/get-involved/",
  "/legal-notice/",
  "/process/",
  "/search/",
  "/sitemap/",
  "/terms/",
  "/terms-and-concepts/",
];

const contentPages =
  articles.length + cases.length + termsAndConcepts.length + process.length;
const hubIndex = buildHubIndex(
  cases.map((c) => ({
    id: c.id,
    tags: c.data.tags ?? [],
    court: c.data.court,
  })),
);
const hubPages =
  hubIndex.states.size + hubIndex.circuits.size + hubIndex.topics.size;
const generatedPages = hubPages + STATE_LIMITATIONS.length;
const totalPages = contentPages + staticPages.length + generatedPages;

// Estimate reading time from content body lengths (~5 chars/word, ~250 wpm)
const allContent = [...articles, ...cases, ...termsAndConcepts, ...process];
const totalChars = allContent.reduce(
  (sum, entry) => sum + (entry.body?.length || 0),
  0,
);
const totalWords = Math.round(totalChars / 5);
const readingHours = Math.round(totalWords / 250 / 60);

const uniqueCourts = new Set(cases.map((c) => c.data.court)).size;
const canonicalUrl = "https://www.section1983.org/";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "section1983.org",
    url: canonicalUrl,
    description:
      "A free, independent guide to Section 1983 litigation, case law, federal procedure, and police accountability.",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Institute for Police Conduct, Inc.",
    url: "https://policeconduct.org",
  },
];
---

<Base
  title="Section 1983 Guide to Police Accountability"
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
>
  <section class="mb-16">
    <p
      class="text-sm font-semibold text-gold-strong uppercase tracking-wide mb-3"
    >
      A project of the Institute for Police Conduct, Inc.
    </p>
    <h1 class="text-4xl md:text-5xl font-bold text-navy leading-tight mb-6">
      Your free guide to holding<br />
      <span class="text-gold-strong">police accountable in federal court.</span>
    </h1>
    <p class="text-lg text-slate-strong max-w-2xl leading-relaxed mb-4">
      When police violate your constitutional rights, federal law gives you the
      right to sue. This site explains how to sue the police under 42 U.S.C. §
      1983 for excessive force, false arrest, retaliation, and what happened in
      jail, how qualified immunity works against you, and what a federal civil
      rights lawsuit looks like from the first records request to trial. Plain
      language, real cases, for people representing themselves.
    </p>
    <p class="text-base text-slate-strong max-w-2xl leading-relaxed mb-8">
      We are <strong class="text-navy">completely independent</strong> of police and
      government. No sponsors. No agenda. Just the law, explained honestly.
    </p>
    <div class="flex gap-4 flex-wrap">
      <a
        href="/articles/how-to-sue-the-police-section-1983-guide"
        class="bg-navy text-white px-6 py-3 rounded font-semibold hover:bg-navy-light transition-colors focus-ring"
      >
        Start Here: How to Sue the Police
      </a>
      <a
        href="/terms-and-concepts"
        class="border-2 border-navy text-navy px-6 py-3 rounded font-semibold hover:bg-navy hover:text-white transition-colors"
      >
        Terms and Concepts
      </a>
      <a
        href="/process"
        class="border-2 border-navy text-navy px-6 py-3 rounded font-semibold hover:bg-navy hover:text-white transition-colors"
      >
        Understand the Process
      </a>
      <a
        href="https://policeconduct.org/report/new"
        class="border-2 border-gold text-navy px-6 py-3 rounded font-semibold hover:bg-gold hover:text-navy transition-colors focus-ring"
        target="_blank"
        rel="noopener"
      >
        Report an Incident ↗
      </a>
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-2xl font-bold text-navy mb-3 border-b-2 border-gold pb-2">
      Find What You Need
    </h2>
    <div class="grid gap-4 md:grid-cols-2">
      <a
        href="/articles/how-to-sue-the-police-section-1983-guide"
        class="interactive-card focus-ring block rounded-lg border border-slate-200 bg-white p-5"
      >
        <h3 class="font-bold text-navy">How to sue the police</h3>
        <p class="text-sm text-slate-strong mt-1">
          The whole case in one guide: what Section 1983 covers, who you can
          sue, qualified immunity, deadlines, and every stage from complaint to
          trial.
        </p>
      </a>
      <a
        href="/statute-of-limitations/"
        class="interactive-card focus-ring block rounded-lg border border-slate-200 bg-white p-5"
      >
        <h3 class="font-bold text-navy">How long you have to file</h3>
        <p class="text-sm text-slate-strong mt-1">
          The Section 1983 statute of limitations for every state, with the
          statute, and when the clock actually starts.
        </p>
      </a>
      <a
        href="/articles/what-do-i-file-and-when-section-1983-deadline-map"
        class="interactive-card focus-ring block rounded-lg border border-slate-200 bg-white p-5"
      >
        <h3 class="font-bold text-navy">What to file, and by when</h3>
        <p class="text-sm text-slate-strong mt-1">
          One table mapping each docket event to the document you file and its
          federal deadline.
        </p>
      </a>
      <a
        href="/downloads/"
        class="interactive-card focus-ring block rounded-lg border border-slate-200 bg-white p-5"
      >
        <h3 class="font-bold text-navy">Sample documents</h3>
        <p class="text-sm text-slate-strong mt-1">
          A complaint, a declaration, a response to a motion to dismiss, and
          more, in PDF, Word, and plain text.
        </p>
      </a>
      <a
        href="/articles/monell-claims-the-complete-guide-to-suing-a-city"
        class="interactive-card focus-ring block rounded-lg border border-slate-200 bg-white p-5"
      >
        <h3 class="font-bold text-navy">Suing the city</h3>
        <p class="text-sm text-slate-strong mt-1">
          The complete Monell guide: the six paths to municipal liability and
          how to plead each one.
        </p>
      </a>
      <a
        href="/cases/"
        class="interactive-card focus-ring block rounded-lg border border-slate-200 bg-white p-5"
      >
        <h3 class="font-bold text-navy">Cases by state, court, and topic</h3>
        <p class="text-sm text-slate-strong mt-1">
          Excessive force, false arrest, qualified immunity denied, Monell, and
          more, from the Supreme Court and the Fifth Circuit.
        </p>
      </a>
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-2xl font-bold text-navy mb-3 border-b-2 border-gold pb-2">
      What Is On The Site Right Now
    </h2>
    <p class="text-sm text-slate mb-6 max-w-3xl">
      These numbers show what is live on the public site right now: articles to
      train you, case summaries to show how courts rule, terms and concepts
      entries to translate legal language, and process guides to walk you
      through a federal case step by step. The total page count below also
      includes the home page and the main section pages.
    </p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      <div class="text-center p-6 bg-white rounded-lg shadow-sm">
        <p class="text-3xl font-bold text-navy">{cases.length}</p>
        <p class="text-sm text-slate mt-1">Case Summaries</p>
      </div>
      <div class="text-center p-6 bg-white rounded-lg shadow-sm">
        <p class="text-3xl font-bold text-navy">{termsAndConcepts.length}</p>
        <p class="text-sm text-slate mt-1">Terms and Concepts</p>
      </div>
      <div class="text-center p-6 bg-white rounded-lg shadow-sm">
        <p class="text-3xl font-bold text-navy">{process.length}</p>
        <p class="text-sm text-slate mt-1">Process Guides</p>
      </div>
      <div class="text-center p-6 bg-white rounded-lg shadow-sm">
        <p class="text-3xl font-bold text-navy">
          {articles.length}
        </p>
        <p class="text-sm text-slate mt-1">Articles</p>
      </div>
    </div>
    <p class="text-center text-sm text-slate mt-4">
      {totalPages} published pages · {uniqueCourts} courts cited · about{" "}
      {readingHours} hours of reading · free to use
    </p>
  </section>

  <section>
    <h2 class="text-2xl font-bold text-navy mb-3 border-b-2 border-gold pb-2">
      Articles
    </h2>
    <p class="text-sm text-slate mb-6">
      Read the articles in order from oldest to newest.
    </p>
    <div class="space-y-6">
      {
        articles
          .slice(0, 5)
          .map((article) => <ArticleCard article={article} headingLevel="h3" />)
      }
    </div>
    <p class="text-sm text-slate mt-6">
      Want more articles? Browse all <a
        href="/articles"
        class="focus-ring surface-link text-navy underline decoration-gold decoration-2"
      >
        Section 1983 articles
      </a>.
    </p>
  </section>
</Base>
