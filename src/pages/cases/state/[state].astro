---
import { getCollection } from "astro:content";
import CaseHub from "../../../layouts/CaseHub.astro";
import { CIRCUITS, STATE_CIRCUIT, STATE_LABELS } from "../../../lib/case-hubs";
import { buildHubIndex } from "../../../lib/case-hub-index";

export async function getStaticPaths() {
  const cases = await getCollection("cases");
  const index = buildHubIndex(
    cases.map((c) => ({
      id: c.id,
      tags: c.data.tags ?? [],
      court: c.data.court,
    })),
  );
  const byId = new Map(cases.map((c) => [c.id, c]));
  const allStates = [...index.states.entries()].map(([slug, ids]) => ({
    slug,
    label: STATE_LABELS[slug],
    count: ids.length,
  }));

  return [...index.states.entries()].map(([state, ids]) => ({
    params: { state },
    props: {
      state,
      cases: ids.map((id) => byId.get(id)!),
      allStates,
      circuit: index.circuits.has(STATE_CIRCUIT[state])
        ? STATE_CIRCUIT[state]
        : undefined,
    },
  }));
}

const { state, cases, allStates, circuit } = Astro.props;
const label = STATE_LABELS[state];
const circuitMeta = CIRCUITS[STATE_CIRCUIT[state]];
const canonicalUrl = `https://www.section1983.org/cases/state/${state}/`;

const title = `${label} Section 1983 Cases`;
const description = `Section 1983 police misconduct cases from ${label}: excessive force, false arrest, qualified immunity, and Monell decisions from the ${circuitMeta?.label ?? "federal courts"} and the courts in ${label}, explained in plain language.`;
const intro = `These are the cases in the library that arose in ${label} or bind courts there. Federal district courts in ${label} sit in the ${circuitMeta?.label ?? "federal circuit"}, so published ${circuitMeta?.label ?? "circuit"} decisions and Supreme Court decisions control. State-court decisions are included where they decide a probable-cause or offense-element question that a Section 1983 court will look to.`;
const note = `A case is tagged to a state when it arose there or when it is binding precedent for federal courts there. Circuit decisions are tagged to every state in the circuit.`;

const articles = await getCollection("articles", ({ data }) => !data.draft);
const pick = (slugs: string[]) =>
  slugs
    .map((s) => articles.find((a) => a.id === s))
    .filter(Boolean)
    .map((a) => ({
      href: `/articles/${a!.id}`,
      label: a!.data.title,
      description: a!.data.description,
    }));
const relatedArticles = pick([
  "statute-of-limitations-and-tolling-in-a-section-1983-case",
  "how-to-research-clearly-established-law-in-a-section-1983-case",
  "local-rules-and-standing-orders-in-a-section-1983-case",
]);

const crumbs = [
  { label: "Home", href: "/" },
  { label: "Case Law Library", href: "/cases" },
  { label: label },
];

const siblings = {
  heading: "Other states",
  links: allStates
    .filter((s) => s.slug !== state)
    .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label))
    .map((s) => ({
      href: `/cases/state/${s.slug}/`,
      label: s.label,
      count: s.count,
    }))
    .concat(
      circuit
        ? [
            {
              href: `/cases/circuit/${circuit}/`,
              label: `All ${CIRCUITS[circuit].label} cases`,
              count: cases.length,
            },
          ]
        : [],
    ),
};
---

<CaseHub
  title={title}
  pageTitle={title}
  description={description}
  intro={intro}
  note={note}
  canonicalUrl={canonicalUrl}
  crumbs={crumbs}
  cases={cases.map((c) => ({
    id: c.id,
    title: c.data.title,
    citation: c.data.citation,
    court: c.data.court,
    dateDecided: c.data.dateDecided,
    holding: c.data.holding,
    tags: c.data.tags ?? [],
  }))}
  relatedArticles={relatedArticles}
  siblings={siblings}
/>
