---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page Not Found"
  description="The page you were looking for does not exist on section1983.org. Search the site or start from the process guide, articles, case law library, or terms and concepts."
  robots="noindex,follow"
>
  <section class="max-w-2xl mx-auto py-12 text-center">
    <p class="text-sm font-semibold text-navy uppercase tracking-wide mb-3">
      404
    </p>
    <h1 class="text-4xl font-bold text-navy mb-4">Page not found</h1>
    <p class="text-lg text-slate-700 mb-8">
      That page does not exist, or it moved. Try a search, or start from one of
      the main sections below.
    </p>
    <form action="/search/" method="get" class="mb-10" role="search">
      <label for="not-found-search" class="sr-only">Search the site</label>
      <div class="flex gap-2 max-w-md mx-auto">
        <input
          id="not-found-search"
          type="search"
          name="q"
          placeholder="Search section1983.org"
          class="flex-1 border border-slate-300 rounded px-4 py-2 focus-ring"
        />
        <button
          type="submit"
          class="bg-navy text-white font-semibold px-4 py-2 rounded hover:bg-navy-light focus-ring"
        >
          Search
        </button>
      </div>
    </form>
    <nav aria-label="Main sections">
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-left">
        <li>
          <a
            href="/process/"
            class="block border border-slate-200 rounded-lg p-4 hover:border-gold focus-ring"
          >
            <span class="font-bold text-navy">The Process</span>
            <span class="block text-sm text-slate-600"
              >Step-by-step guide to a Section 1983 case in federal court.</span
            >
          </a>
        </li>
        <li>
          <a
            href="/articles/"
            class="block border border-slate-200 rounded-lg p-4 hover:border-gold focus-ring"
          >
            <span class="font-bold text-navy">Articles</span>
            <span class="block text-sm text-slate-600"
              >Plain-language articles on claims, pleading, and defenses.</span
            >
          </a>
        </li>
        <li>
          <a
            href="/cases/"
            class="block border border-slate-200 rounded-lg p-4 hover:border-gold focus-ring"
          >
            <span class="font-bold text-navy">Case Law Library</span>
            <span class="block text-sm text-slate-600"
              >Section 1983 decisions explained in plain language.</span
            >
          </a>
        </li>
        <li>
          <a
            href="/terms-and-concepts/"
            class="block border border-slate-200 rounded-lg p-4 hover:border-gold focus-ring"
          >
            <span class="font-bold text-navy">Terms and Concepts</span>
            <span class="block text-sm text-slate-600"
              >Definitions of the doctrines and procedural rules you will meet.</span
            >
          </a>
        </li>
      </ul>
    </nav>
  </section>
</Base>
