---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const canonicalUrl = "https://www.section1983.org/search/";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SearchResultsPage",
  name: "Search section1983.org",
  description:
    "Search articles, cases, terms and concepts entries, and process guides on section1983.org.",
  url: canonicalUrl,
  potentialAction: {
    "@type": "SearchAction",
    target: "https://www.section1983.org/search/?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};
---

<Base
  title="Search Section 1983 Articles, Cases, and Terms and Concepts"
  description="Search Section 1983 articles, case summaries, terms and concepts entries, and process guides on section1983.org."
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
>
  <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Search" }]} />

  <h1 class="text-3xl font-bold text-navy mb-6">Search</h1>

  <div class="mb-8">
    <label for="search-input" class="sr-only">Search the site</label>
    <p id="search-help" class="text-sm text-slate mb-3">
      Search cases, articles, terms and concepts, and process guides.
    </p>
    <input
      id="search-input"
      type="search"
      placeholder="Search cases, articles, terms and concepts, process steps... (try 'tased' or 'beaten')"
      autocomplete="off"
      aria-describedby="search-help"
      class="w-full min-h-12 px-4 py-3 border-2 border-slate-300 rounded-lg text-navy focus:border-gold-strong focus-ring text-lg"
    />
  </div>

  <div
    id="search-results"
    class="space-y-4"
    role="status"
    aria-live="polite"
    aria-label="Search results"
  >
    <p class="text-slate">Type to search across all content.</p>
  </div>

  <script is:inline>
    const input = document.getElementById("search-input");
    const results = document.getElementById("search-results");
    let index = null;

    const typeLabels = {
      article: "Article",
      termsAndConcepts: "Terms and Concepts",
      process: "Process",
      case: "Case",
    };
    const typeColors = {
      article:
        "bg-[color:color-mix(in_srgb,var(--color-gold)_12%,white)] text-navy",
      termsAndConcepts:
        "bg-[color:color-mix(in_srgb,var(--color-navy)_10%,white)] text-navy",
      process:
        "bg-[color:color-mix(in_srgb,var(--color-gold)_8%,white)] text-[color:var(--color-slate-strong)]",
      case: "bg-[color:color-mix(in_srgb,var(--color-cream)_70%,white)] text-navy",
    };

    function setMessage(message, className = "text-slate") {
      results.innerHTML = `<p class="${className}">${message}</p>`;
    }

    async function loadIndex() {
      if (index) return index;
      const res = await fetch("/search.json");
      if (!res.ok) {
        throw new Error("Search index failed to load.");
      }
      index = await res.json();
      return index;
    }

    function search(query) {
      if (!index) return [];
      const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
      if (!terms.length) return [];
      return index
        .filter((item) => {
          const haystack = (
            item.title +
            " " +
            item.description +
            " " +
            (item.tags || []).join(" ")
          ).toLowerCase();
          return terms.every((t) => haystack.includes(t));
        })
        .slice(0, 20);
    }

    function render(items, query) {
      if (!query.trim()) {
        setMessage("Type to search across all content.");
        return;
      }
      if (!items.length) {
        setMessage("No results found. Try different terms.");
        return;
      }
      results.innerHTML = items
        .map(
          (item) => `
        <a href="${item.url}" class="interactive-card focus-ring block p-4 bg-white rounded border border-slate-200">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs font-bold px-2 py-0.5 rounded ${typeColors[item.type] || ""}">${typeLabels[item.type] || item.type}</span>
            <span class="font-semibold text-navy">${item.title}</span>
          </div>
          <p class="text-sm text-slate">${item.description}</p>
        </a>
      `,
        )
        .join("");
    }

    let debounce;
    input.addEventListener("input", () => {
      clearTimeout(debounce);
      debounce = setTimeout(async () => {
        results.setAttribute("aria-busy", "true");
        try {
          await loadIndex();
          render(search(input.value), input.value);
        } catch {
          setMessage(
            "Search is unavailable right now. Refresh the page and try again.",
          );
        } finally {
          results.setAttribute("aria-busy", "false");
        }
      }, 150);
    });

    // Support ?q= query param
    const params = new URLSearchParams(window.location.search);
    const q = params.get("q");
    if (q) {
      input.value = q;
      results.setAttribute("aria-busy", "true");
      loadIndex()
        .then(() => render(search(q), q))
        .catch(() => {
          setMessage(
            "Search is unavailable right now. Refresh the page and try again.",
          );
        })
        .finally(() => {
          results.setAttribute("aria-busy", "false");
        });
    }
  </script>
</Base>
