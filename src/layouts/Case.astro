---
import Base from "./Base.astro";
import { caseTitle } from "../lib/seo";
import type { RelatedLink } from "../lib/related";
import type { HubLink } from "../lib/case-hub-index";

interface Props {
  title: string;
  citation: string;
  court: string;
  dateDecided: Date;
  updatedDate?: Date;
  docketNumber: string;
  canonicalUrl: string;
  courtlistener?: string;
  holding: string;
  officers?: { name: string; profile?: string }[];
  tags?: string[];
  cites?: string[];
  citedBy?: string[];
  hubLinks?: HubLink[];
  relatedTermsAndConcepts?: RelatedLink[];
  relatedArticles?: RelatedLink[];
}

const {
  title,
  citation,
  court,
  dateDecided,
  updatedDate,
  docketNumber,
  canonicalUrl,
  courtlistener,
  holding,
  officers,
  tags,
  cites,
  citedBy,
  hubLinks = [],
  relatedTermsAndConcepts = [],
  relatedArticles = [],
} = Astro.props;

const hubHrefByTag = new Map<string, string>();
for (const link of hubLinks) {
  if (link.kind === "state") {
    hubHrefByTag.set(link.href.split("/")[3], link.href);
  }
}
const topicLinks = hubLinks.filter((l) => l.kind === "topic");
const circuitLink = hubLinks.find((l) => l.kind === "circuit");

const formattedDate = dateDecided.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

function shortenMetaDescription(text, maxLength = 155) {
  const normalized = text.replace(/\s+/g, " ").trim();
  if (normalized.length <= maxLength) return normalized;

  const sentenceBreak = normalized.lastIndexOf(". ", maxLength);
  if (sentenceBreak >= 90) {
    return normalized.slice(0, sentenceBreak + 1);
  }

  const clauseBreaks = [
    normalized.lastIndexOf("; ", maxLength),
    normalized.lastIndexOf(", ", maxLength),
    normalized.lastIndexOf(" — ", maxLength),
  ].filter((index) => index >= 90);

  const bestClauseBreak = Math.max(-1, ...clauseBreaks);
  if (bestClauseBreak >= 90) {
    return `${normalized.slice(0, bestClauseBreak).trim()}.`;
  }

  const wordBreak = normalized.lastIndexOf(" ", maxLength - 1);
  if (wordBreak >= 90) {
    return `${normalized.slice(0, wordBreak).trim()}...`;
  }

  return `${normalized.slice(0, maxLength - 3).trim()}...`;
}

const metaDescription = shortenMetaDescription(holding);
const pageTitle = caseTitle(title, citation, court, tags);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "LegalCase",
  name: title,
  headline: title,
  description: metaDescription,
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  datePublished: dateDecided.toISOString(),
  dateCreated: dateDecided.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  court,
  legislationType: "Case law",
  legislationIdentifier: citation,
  keywords: tags?.join(", "),
};
---

<Base
  title={pageTitle}
  description={metaDescription}
  canonicalUrl={canonicalUrl}
  ogType="article"
  ogImageAlt={title}
  structuredData={structuredData}
>
  <slot name="breadcrumbs" />
  <article class="prose prose-slate max-w-none">
    <!-- Case Info Header -->
    <div class="mb-8 bg-navy-light/5 border border-slate-200 rounded-lg p-6">
      <h1 class="text-3xl font-bold text-navy mb-1 italic">{title}</h1>
      <p class="text-lg text-slate-700 font-mono mb-4">{citation}</p>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-2 text-sm text-slate-600 mb-4"
      >
        <div><span class="font-semibold text-navy">Court:</span> {court}</div>
        <div>
          <span class="font-semibold text-navy">Decided:</span>
          {formattedDate}
        </div>
        <div>
          <span class="font-semibold text-navy">Docket:</span>
          {docketNumber}
        </div>
        {
          courtlistener && (
            <div>
              <a
                href={courtlistener}
                target="_blank"
                rel="noopener"
                class="focus-ring surface-link text-navy underline decoration-gold decoration-2 underline-offset-2"
              >
                View on CourtListener ↗
              </a>
            </div>
          )
        }
      </div>

      {
        officers && officers.length > 0 && (
          <div class="text-sm text-slate-600 mb-4">
            <span class="font-semibold text-navy">Officers named:</span>{" "}
            {officers.map((o, i) => (
              <>
                {i > 0 && ", "}
                {o.profile ? (
                  <a
                    href={o.profile}
                    target="_blank"
                    rel="noopener"
                    class="focus-ring surface-link text-navy underline decoration-gold decoration-2 underline-offset-2"
                  >
                    {o.name} ↗
                  </a>
                ) : (
                  <span>{o.name}</span>
                )}
              </>
            ))}
          </div>
        )
      }

      <div class="bg-cream rounded p-4 border-l-4 border-gold">
        <p class="font-semibold text-navy text-sm mb-1">Holding</p>
        <p class="text-slate-800">{holding}</p>
      </div>
    </div>

    {
      tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          {tags.map((tag) => (
            <a
              href={hubHrefByTag.get(tag) ?? `/cases/?tags=${tag}`}
              class="text-xs bg-slate-100 hover:bg-gold hover:text-navy px-3 py-1 rounded transition-colors focus-ring"
            >
              {tag.replace(/-/g, " ")}
            </a>
          ))}
        </div>
      )
    }

    {
      (circuitLink || topicLinks.length > 0) && (
        <p class="text-sm text-slate-600 mb-8 not-prose">
          <span class="font-semibold text-navy">Browse related cases:</span>{" "}
          {[...(circuitLink ? [circuitLink] : []), ...topicLinks].map(
            (l, i) => (
              <>
                {i > 0 && " · "}
                <a
                  href={l.href}
                  class="focus-ring surface-link text-navy underline decoration-gold decoration-2"
                >
                  {l.label} ({l.count})
                </a>
              </>
            ),
          )}
        </p>
      )
    }

    <!-- Article content (summary, how to use it, how it can be used against you) -->
    <slot />

    <!-- Cross-references -->
    {
      cites && cites.length > 0 && (
        <div class="mt-12 pt-8 border-t border-slate-200">
          <h2 class="text-lg font-bold text-navy mb-3">Cases Cited</h2>
          <div class="flex flex-wrap gap-2">
            {cites.map((slug) => (
              <a
                href={`/cases/${slug}`}
                class="text-sm bg-slate-100 hover:bg-gold hover:text-navy px-3 py-1 rounded transition-colors italic"
              >
                {slug
                  .replace(/-/g, " ")
                  .replace(/\b\w/g, (c) => c.toUpperCase())}
              </a>
            ))}
          </div>
        </div>
      )
    }

    {
      citedBy && citedBy.length > 0 && (
        <div class="mt-8 pt-8 border-t border-slate-200">
          <h2 class="text-lg font-bold text-navy mb-3">Cited By</h2>
          <div class="flex flex-wrap gap-2">
            {citedBy.map((slug) => (
              <a
                href={`/cases/${slug}`}
                class="text-sm bg-slate-100 hover:bg-gold hover:text-navy px-3 py-1 rounded transition-colors italic"
              >
                {slug
                  .replace(/-/g, " ")
                  .replace(/\b\w/g, (c) => c.toUpperCase())}
              </a>
            ))}
          </div>
        </div>
      )
    }

    {
      (relatedTermsAndConcepts.length > 0 || relatedArticles.length > 0) && (
        <aside class="mt-12 border-t border-slate-200 pt-8 not-prose">
          <h2 class="text-xl font-bold text-navy mb-4">Keep Reading</h2>
          <div class="grid gap-6 md:grid-cols-2">
            {relatedArticles.length > 0 && (
              <section>
                <h3 class="text-sm font-bold uppercase tracking-wide text-navy mb-3">
                  How to Use This Case
                </h3>
                <div class="space-y-3">
                  {relatedArticles.map((entry) => (
                    <a
                      href={entry.href}
                      class="interactive-card focus-ring block rounded border border-slate-200 bg-white p-4"
                    >
                      <p class="font-semibold text-navy">{entry.label}</p>
                      <p class="mt-1 text-sm text-slate">{entry.description}</p>
                    </a>
                  ))}
                </div>
              </section>
            )}
            {relatedTermsAndConcepts.length > 0 && (
              <section>
                <h3 class="text-sm font-bold uppercase tracking-wide text-navy mb-3">
                  Terms and Concepts
                </h3>
                <div class="space-y-3">
                  {relatedTermsAndConcepts.map((entry) => (
                    <a
                      href={entry.href}
                      class="interactive-card focus-ring block rounded border border-slate-200 bg-white p-4"
                    >
                      <p class="font-semibold text-navy">{entry.label}</p>
                      <p class="mt-1 text-sm text-slate">{entry.description}</p>
                    </a>
                  ))}
                </div>
              </section>
            )}
          </div>
        </aside>
      )
    }

    <slot name="pagination" />
  </article>
</Base>
