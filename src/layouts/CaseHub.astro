---
import Base from "./Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import type { RelatedLink } from "../lib/related";

interface HubCaseSummary {
  id: string;
  title: string;
  citation: string;
  court: string;
  dateDecided: Date;
  holding: string;
  tags: string[];
}

interface SiblingLink {
  href: string;
  label: string;
  count: number;
}

interface Props {
  title: string;
  pageTitle: string;
  description: string;
  intro: string;
  canonicalUrl: string;
  crumbs: { label: string; href?: string }[];
  cases: HubCaseSummary[];
  relatedArticles?: RelatedLink[];
  siblings?: { heading: string; links: SiblingLink[] };
  note?: string;
}

const {
  title,
  pageTitle,
  description,
  intro,
  canonicalUrl,
  crumbs,
  cases,
  relatedArticles = [],
  siblings,
  note,
} = Astro.props;

const sorted = [...cases].sort(
  (a, b) => b.dateDecided.getTime() - a.dateDecided.getTime(),
);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: pageTitle,
  description,
  url: canonicalUrl,
  isPartOf: {
    "@type": "CollectionPage",
    name: "Section 1983 Case Law Library",
    url: "https://www.section1983.org/cases/",
  },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: sorted.length,
    itemListElement: sorted.map((c, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `https://www.section1983.org/cases/${c.id}/`,
      name: c.title,
    })),
  },
};

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<Base
  title={pageTitle}
  description={description}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
>
  <Breadcrumbs crumbs={crumbs} />

  <h1 class="text-3xl font-bold text-navy mb-2">{title}</h1>
  <p class="text-sm text-slate-600 mb-4">
    {sorted.length}
    {sorted.length === 1 ? "case" : "cases"} in the library
  </p>
  <p class="text-lg text-slate-700 mb-6 max-w-3xl">{intro}</p>
  {note && <p class="text-sm text-slate-600 mb-8 max-w-3xl">{note}</p>}

  {
    relatedArticles.length > 0 && (
      <aside class="mb-10 bg-cream border border-gold/30 rounded-lg p-5">
        <h2 class="text-sm font-bold uppercase tracking-wide text-navy mb-3">
          Start with these guides
        </h2>
        <ul class="space-y-2">
          {relatedArticles.map((a) => (
            <li>
              <a
                href={a.href}
                class="focus-ring surface-link font-semibold text-navy underline decoration-gold decoration-2"
              >
                {a.label}
              </a>
              <span class="block text-sm text-slate-600">{a.description}</span>
            </li>
          ))}
        </ul>
      </aside>
    )
  }

  <h2 class="text-xl font-bold text-navy mb-4">Cases, newest first</h2>
  <div class="space-y-4">
    {
      sorted.map((c) => (
        <a
          href={`/cases/${c.id}/`}
          class="interactive-card focus-ring block rounded-lg border border-slate-200 bg-white p-5"
        >
          <p class="font-semibold text-navy italic">{c.title}</p>
          <p class="text-sm text-slate-600 font-mono mt-1">
            {c.citation} · {formatDate(c.dateDecided)}
          </p>
          <p class="mt-2 text-sm text-slate-700">{c.holding}</p>
        </a>
      ))
    }
  </div>

  {
    siblings && siblings.links.length > 0 && (
      <nav
        class="mt-12 border-t border-slate-200 pt-8"
        aria-label={siblings.heading}
      >
        <h2 class="text-sm font-bold uppercase tracking-wide text-navy mb-3">
          {siblings.heading}
        </h2>
        <div class="flex flex-wrap gap-2">
          {siblings.links.map((l) => (
            <a
              href={l.href}
              class="text-sm bg-slate-100 hover:bg-gold hover:text-navy px-3 py-1 rounded transition-colors focus-ring"
            >
              {l.label} <span class="text-slate-500">({l.count})</span>
            </a>
          ))}
        </div>
      </nav>
    )
  }

  <p class="mt-10 text-sm text-slate-600">
    Looking for something else? Use the filters on the
    <a
      href="/cases/"
      class="focus-ring surface-link text-navy underline decoration-gold decoration-2"
      >full case library</a
    >.
  </p>
</Base>
