---
---

<div class="analytics-privacy" data-cookie-settings data-pagefind-ignore>
  <button
    type="button"
    class="inline-flex items-center gap-2 rounded border border-slate-400 px-3 py-2 my-2 min-h-11 align-middle text-sm text-slate-200 hover:text-gold hover:border-gold transition-colors cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
    data-privacy-settings
    hidden
  >
    Cookie settings
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M21 12a9 9 0 1 1-9-9 4 4 0 0 0 4 4 4 4 0 0 0 5 5Z" />
      <path d="M8 8h.01M7 14h.01M12 12h.01M12 17h.01M16 15h.01" />
    </svg>
  </button>
  <dialog
    data-analytics-consent
    aria-labelledby="analytics-consent-title"
    aria-describedby="analytics-consent-description"
    hidden
  >
    <p>
      <strong id="analytics-consent-title">Manage cookie settings</strong>
    </p>
    <p id="analytics-consent-description">
      We use Google Analytics to learn how this site is used. You can allow
      analytics cookies or decline them. If you decline, Google still receives
      limited measurements without analytics cookies. Choose separately whether
      to allow advertising cookies and data use. Change your choices here at any
      time.
    </p>
    <div class="analytics-categories">
      <label>
        <input type="checkbox" checked disabled /> Necessary settings — always
        on
      </label>
      <p>We remember the cookie choice you save in this browser.</p>
      <label>
        <input type="checkbox" data-analytics-enabled /> Analytics cookies
      </label>
      <p>Allow Google Analytics to use cookies to measure visits.</p>
      <label>
        <input type="checkbox" data-advertising-enabled /> Advertising
      </label>
      <p>
        Allow Google to use cookies and visit data for ad measurement and
        personalized ads.
      </p>
    </div>
    <p data-consent-status role="status"></p>
    <div class="analytics-choices">
      <button type="button" data-analytics-choice="granted">
        Allow all
      </button>
      <button type="button" data-analytics-save>
        Save preferences
      </button>
      <button type="button" data-analytics-choice="denied">
        Decline all
      </button>
    </div>
  </dialog>
</div>

<script>
  import { initializeConsentControls } from "../lib/client/analytics-consent.js";
  import { consentPreferences } from "../lib/client/consent-preferences.js";
  import { applyGoogleConsent } from "../lib/client/google-consent.js";

  document.querySelectorAll("[data-cookie-settings]").forEach((root) => {
    initializeConsentControls(
      root,
      consentPreferences,
      (choices: Record<string, string> | null) =>
        applyGoogleConsent(choices, {
          gtag: window.gtag,
          hostname: window.location.hostname,
          document,
        }),
    );
  });
</script>

<style>
  .analytics-privacy dialog {
    width: min(32rem, calc(100vw - 2rem));
    max-height: 80vh;
    overflow-y: auto;
    margin: auto;
    padding: 1.5rem;
    color: var(--color-navy);
    background: #fff;
    border: 1px solid var(--color-navy);
    font-size: 1rem;
    line-height: 1.5;
  }
  .analytics-privacy dialog::backdrop {
    background: rgb(26 31 54 / 45%);
  }
  .analytics-categories label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 650;
  }
  .analytics-categories input {
    width: 1.25rem;
    height: 1.25rem;
  }
  .analytics-categories p {
    margin-top: 0.25rem;
  }
  .analytics-privacy input:focus-visible {
    outline: 3px solid var(--color-navy);
    outline-offset: 3px;
  }
  .analytics-privacy p {
    margin: 0 0 1rem;
  }
  .analytics-choices {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .analytics-choices button {
    font: inherit;
    color: var(--color-navy);
    background: #fff;
    border: 1px solid var(--color-navy);
    padding: 0.5rem 1rem;
    cursor: pointer;
  }
  .analytics-choices button:focus-visible {
    outline: 3px solid var(--color-navy);
    outline-offset: 3px;
  }
</style>
